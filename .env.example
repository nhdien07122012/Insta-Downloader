# Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID của kênh hoặc group Telegram dùng để lưu trữ ảnh (vd: -1001234567890 hoặc @your_channel_username)
# Bot phải là ADMIN trong kênh này để có quyền đăng bài và tải ảnh lên.
TELEGRAM_STORAGE_CHANNEL_ID=your_storage_channel_id_here

# Danh sách ID Telegram của Admin (ngăn người lạ spam bot nếu muốn, cách nhau bằng dấu phẩy)
# Để trống nếu muốn ai cũng dùng được bot.
ALLOWED_USER_IDS=

# Thư mục tạm để tải ảnh trước khi đẩy lên Telegram
TEMP_DOWNLOAD_DIR=downloads

# Tự động xóa tin nhắn chứa link sau khi tải thành công (giúp Kênh luôn gọn đẹp, chỉ có ảnh)
DELETE_LINK_MESSAGE=true

# Database lưu trữ metadata
DATABASE_PATH=insta_storage.db
